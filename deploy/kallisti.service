# Kallisti as a systemd service, without containers (see docs/install-binary.md).
# Install: copy to /etc/systemd/system/, put the settings into
# /etc/kallisti.env, then: systemctl enable --now kallisti
[Unit]
Description=Kallisti (web app, voice and text chat on Mumble)
After=network-online.target
Wants=network-online.target

[Service]
User=kallisti
Group=kallisti
EnvironmentFile=/etc/kallisti.env
ExecStart=/opt/kallisti/kallisti
WorkingDirectory=/var/lib/kallisti
Restart=on-failure
RestartSec=5
TimeoutStopSec=20s
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
# The database, uploads, backups and the Mumble certificate live here.
# Data paths elsewhere (DB_PATH, UPLOAD_DIR, BACKUP_DIR, CERT_DIR) need
# ReadWritePaths= (ProtectSystem=strict).
StateDirectory=kallisti
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
